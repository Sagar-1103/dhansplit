{
  "expo": {
    "name": "Dhansplit",
    "slug": "dhansplit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logos/dhansplit-coin-dark.png",
    "scheme": "dhansplit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0B16",
        "foregroundImage": "./assets/images/logos/dhansplit-coin-dark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logos/dhansplit-coin-dark.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0B16",
          "image": "./assets/images/logos/dhansplit-coin-dark.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0D0B16",
            "image": "./assets/images/logos/dhansplit-coin-dark.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
