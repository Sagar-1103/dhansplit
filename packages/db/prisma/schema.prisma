generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Auth and Users
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  avatarUrl       String?
  phone           String?  @unique
  defaultCurrency String   @default("INR")
  isPro           Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  friendshipsInitiated Friendship[]      @relation("FriendshipInitiator")
  friendshipsReceived  Friendship[]      @relation("FriendshipReceiver")
  groupMemberships     GroupMember[]
  expensesPaid         Expense[]         @relation("ExpensePayer")
  expenseShares        ExpenseShare[]
  settlementsPaid      Settlement[]      @relation("SettlementPayer")
  settlementsReceived  Settlement[]      @relation("SettlementPayee")
  activities           Activity[]
  comments             Comment[]
  refreshTokens        RefreshToken[]
  dailyExpenseLimits   DailyExpenseLimit[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model DailyExpenseLimit {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date
  count  Int      @default(0)

  @@unique([userId, date])
}

// Friends
model Friendship {
  id          String           @id @default(cuid())
  initiatorId String
  receiverId  String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  initiator User @relation("FriendshipInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  receiver  User @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([initiatorId, receiverId])
  @@index([receiverId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

// Groups
model Group {
  id              String    @id @default(cuid())
  name            String
  type            GroupType @default(OTHER)
  coverImageUrl   String?
  simplifyDebts   Boolean  @default(true)
  defaultCurrency String   @default("INR")
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members       GroupMember[]
  expenses      Expense[]
  settlements   Settlement[]
  activities    Activity[]
  defaultSplits DefaultSplit[]
}

enum GroupType {
  HOME
  TRIP
  COUPLE
  OTHER
}

model GroupMember {
  id       String         @id @default(cuid())
  groupId  String
  userId   String
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime       @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

enum GroupMemberRole {
  ADMIN
  MEMBER
}

// Expenses
model Expense {
  id          String    @id @default(cuid())
  description String
  amount      Decimal   @db.Decimal(12, 2)
  currency    String    @default("INR")
  category    String    @default("general")
  date        DateTime  @default(now())
  notes       String?
  receiptUrl  String?
  splitType   SplitType @default(EQUAL)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?

  paidById String
  paidBy   User   @relation("ExpensePayer", fields: [paidById], references: [id])

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)

  shares     ExpenseShare[]
  comments   Comment[]
  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([paidById])
  @@index([date])
  @@index([isDeleted])
}

enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
  SHARES
}

model ExpenseShare {
  id         String  @id @default(cuid())
  expenseId  String
  userId     String
  amount     Decimal @db.Decimal(12, 2)
  percentage Decimal? @db.Decimal(5, 2)
  shares     Int?
  paidAmount Decimal @default(0) @db.Decimal(12, 2)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@index([userId])
}

// Settlements
model Settlement {
  id       String           @id @default(cuid())
  amount   Decimal          @db.Decimal(12, 2)
  currency String           @default("INR")
  method   SettlementMethod @default(CASH)
  notes    String?

  payerId String
  payeeId String
  groupId String?

  payer User   @relation("SettlementPayer", fields: [payerId], references: [id])
  payee User   @relation("SettlementPayee", fields: [payeeId], references: [id])
  group Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  activities Activity[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([payerId])
  @@index([payeeId])
  @@index([groupId])
}

enum SettlementMethod {
  CASH
  BANK_TRANSFER
  UPI
  PAYPAL
  VENMO
  OTHER
}

// Recurring Expenses
model RecurringExpense {
  id          String    @id @default(cuid())
  description String
  amount      Decimal   @db.Decimal(12, 2)
  currency    String    @default("INR")
  category    String    @default("general")
  splitType   SplitType @default(EQUAL)
  frequency   Frequency
  nextDueDate DateTime
  isActive    Boolean   @default(true)
  endDate     DateTime?

  paidById String
  groupId  String?

  splitConfig Json?

  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nextDueDate])
  @@index([isActive])
}

enum Frequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

// Activity and Comments
model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  description String
  metadata    Json?

  userId       String
  groupId      String?
  expenseId    String?
  settlementId String?

  user       User        @relation(fields: [userId], references: [id])
  group      Group?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  expense    Expense?    @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  settlement Settlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([groupId])
  @@index([expenseId])
  @@index([createdAt])
}

enum ActivityType {
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  SETTLEMENT_CREATED
  SETTLEMENT_DELETED
  GROUP_CREATED
  GROUP_UPDATED
  GROUP_MEMBER_ADDED
  GROUP_MEMBER_REMOVED
  FRIEND_ADDED
  COMMENT_ADDED
}

model Comment {
  id        String @id @default(cuid())
  content   String
  userId    String
  expenseId String

  user    User    @relation(fields: [userId], references: [id])
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expenseId])
}

// Pro Features
model DefaultSplit {
  id      String @id @default(cuid())
  name    String
  groupId String
  config  Json // { userId: percentage/shares }

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model Currency {
  code      String   @id // "USD", "INR", "EUR"
  name      String
  symbol    String
  rate      Decimal  @db.Decimal(12, 6) // rate relative to USD
  updatedAt DateTime @default(now())
}